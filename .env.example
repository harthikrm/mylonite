# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Meta Model API key (team key; starts with "LLM_"). Read only by the host orchestrator,
# never passed into a sandbox. See docs/THREAT_MODEL.md (T4, T5).
MODEL_API_KEY=

# Provisional defaults; see docs/ARCHITECTURE.md §6.
MYLONITE_MODEL=muse-spark-1.3
MYLONITE_MODEL_BASE_URL=https://api.meta.ai/v1
